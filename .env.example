# Market data back end.
#
# Our own server (npm run server) and the live Avalon feed speak the same
# protocol, so these two variables are the only difference between them.
#
#   local   ws://localhost:3100/echo/websocket
#   live    wss://ws.trade.avalonbroker.com/echo/websocket

# Read by the browser. NEXT_PUBLIC_ values are compiled into the client bundle,
# so never put a real session id here for a deployed site.
NEXT_PUBLIC_AVALON_WS_URL=ws://localhost:3100/echo/websocket
NEXT_PUBLIC_AVALON_SSID=dev-session

# Read by the Next.js route handler, server side only.
AVALON_WS_URL=ws://localhost:3100/echo/websocket
AVALON_SSID=dev-session

# ---------------------------------------------------------------- database
# These four are read by three different things, and they have to agree:
# `docker compose` creates the container from them, Prisma connects with
# DATABASE_URL, and the app's driver adapter takes the pool settings separately.
#
#   cp .env.example .env     then replace every <...> with a real value
#   docker compose up -d     starts MySQL on MYSQL_PORT, data in a named volume
#   npm run db:migrate       creates the tables
#   npm run db:seed          fills the instrument catalogue
#
# The container reads MYSQL_ROOT_PASSWORD, MYSQL_USER, MYSQL_PASSWORD and
# MYSQL_DATABASE only on its **first** start, when the data directory is empty.
# Changing them afterwards does nothing; change a password in SQL, or
# `docker compose down -v` and start over, which throws the data away.
#
# Generate the passwords rather than choosing them:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 24
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3308"
MYSQL_USER="avalon"
MYSQL_PASSWORD="<application password>"
MYSQL_DATABASE="avalon"
MYSQL_ROOT_PASSWORD="<root password>"

# Same credentials as above, in the form Prisma's CLI wants.
DATABASE_URL="mysql://avalon:<application password>@127.0.0.1:3308/avalon"

# ------------------------------------------------------------------- auth
# Signs the session cookie. Changing it signs everyone out. Generate it:
#   openssl rand -base64 32
AUTH_SECRET="<32 random bytes, base64>"

# Set to 1 to let the market feed accept an ssid nobody issued, handing it a
# fresh practice account. It is how this server worked before accounts existed
# and it is convenient — the engine can be booted with no web app running — but
# it is an open door. Leave it unset anywhere real.
# AVALON_ALLOW_ANONYMOUS=1

# Twelve Data, the forex feed. Get a key at twelvedata.com; the free plan
# streams EUR/USD only, which is enough to see real 5s candles.
TWELVEDATA_API_KEY=

# ---------------------------------------------------------------- affiliates
# The web server brings the affiliate ledger up to date once a minute — the
# revenue share settled deals earn is written by reading what has settled (see
# src/instrumentation.ts). It is safe to run in every instance at once. Set to
# "off" to leave it to the pages that show the ledger, which also accrue first.
# AFFILIATE_ACCRUAL=off

# ------------------------------------------------------------------- cards
# The card processor behind the card rail and the saved cards. Unset means no
# card payments: a card rail is hidden from the deposit page. "sandbox" is the
# test processor — only test cards (4242 4242 4242 4242 and the others listed
# on the card form), nothing charged, and an approved test charge credits the
# real wallet. A production build ignores it unless ALLOW_CARD_SANDBOX=1, for a
# staging server; never set that on a live one.
# CARD_PROVIDER=sandbox
# ALLOW_CARD_SANDBOX=1

# fastforex, o feed de forex. A chave é pessoal; .env é gitignored.
FASTFOREX_API_KEY=
