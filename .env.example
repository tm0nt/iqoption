# Market data back end.
#
# Our own server (npm run server) and the live Avalon feed speak the same
# protocol, so these two variables are the only difference between them.
#
#   local   ws://localhost:3100/echo/websocket
#   live    wss://ws.trade.avalonbroker.com/echo/websocket

# Read by the browser. NEXT_PUBLIC_ values are compiled into the client bundle,
# so never put a real session id here for a deployed site.
NEXT_PUBLIC_AVALON_WS_URL=ws://localhost:3100/echo/websocket
NEXT_PUBLIC_AVALON_SSID=dev-session

# Read by the Next.js route handler, server side only.
AVALON_WS_URL=ws://localhost:3100/echo/websocket
AVALON_SSID=dev-session

# ---------------------------------------------------------------- database
# Prisma reads DATABASE_URL through prisma7.config.ts; the MariaDB driver
# adapter the client uses takes its pool settings separately, and the two have
# to address the same database.
#
# Create the database and a user that owns it, then fill these in. Migrations
# also need rights to create a shadow database:
#
#   CREATE DATABASE avalon CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'avalon'@'%' IDENTIFIED BY '<password>';
#   GRANT ALL PRIVILEGES ON avalon.* TO 'avalon'@'%';
#   GRANT ALL PRIVILEGES ON `prisma_migrate_shadow_db%`.* TO 'avalon'@'%';
#
#   npm run db:migrate && npm run db:seed
DATABASE_URL="mysql://avalon:<password>@127.0.0.1:3306/avalon"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="avalon"
MYSQL_PASSWORD="<password>"
MYSQL_DATABASE="avalon"
