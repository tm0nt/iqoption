// The platform's data contract.
//
// The shapes here are not free inventions: an `Asset` row has to be able to
// produce the `active` descriptor the engine reads, field for field, because
// the client validates it and drops an instrument it cannot parse. Anything the
// protocol reads is a column, so an administrator can change it without a
// deploy; anything the protocol derives (`commission` from `profit`, the group
// key from the group) stays derived.
//
// See docs/avalon-backend.md for what each field means on the wire.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// A row in the asset selector. The engine reads `key` as a localization id.
model AssetGroup {
  /// Matches `active_group_id` on every asset in it.
  id       Int     @id
  /// The engine translates this, e.g. `front.crypto`.
  key      String  @unique
  name     String
  priority Int     @default(100)
  enabled  Boolean @default(true)

  assets Asset[]

  @@map("asset_groups")
}

/// Where an instrument's prices come from.
enum PriceSource {
  /// Binance klines and live trades, keyed by `sourceSymbol`.
  BINANCE
  /// Twelve Data, for forex. `sourceSymbol` is their spelling: `EUR/USD`.
  /// Its REST stops at one minute, so the one-second series is recorded from
  /// their tick stream by this server — see server/market/twelvedata.mjs.
  TWELVEDATA
  /// The deterministic curve in server/market/prices.mjs. The fallback for an
  /// instrument with no feed, and for any bucket a feed cannot cover.
  SIMULATED
}

/// One tradable instrument.
model Asset {
  /// The `active_id` on the wire. Deliberately not auto-increment: the ids
  /// follow the feed's own numbering so a client can be repointed between this
  /// server and the live one without changing anything but a URL.
  id     Int    @id
  ticker String @unique
  /// Shown in the selector: "Bitcoin", "EUR/USD".
  name   String
  /// forex | crypto | index | stock | commodity. Drives the default group.
  kind   String

  groupId Int        @map("group_id")
  group   AssetGroup @relation(fields: [groupId], references: [id])

  source       PriceSource @default(SIMULATED)
  /// The symbol at the source: `BTCUSDT` for Binance. Null for SIMULATED.
  sourceSymbol String?     @map("source_symbol")

  /// Price decimals. Binance reports its own; this is what the chart draws.
  precision   Int
  pipScale    Int   @default(2) @map("pip_scale")
  /// Half-spreads, in pips, added to and subtracted from the mid price.
  spreadPlus  Float @default(0.4) @map("spread_plus")
  spreadMinus Float @default(0.1) @map("spread_minus")

  /// Payout percent for a winning binary option. The wire carries
  /// `commission: 100 - profit`.
  profit      Int  @default(80)
  /// Seconds before expiry when the deal panel stops accepting orders.
  deadtime    Int  @default(2)
  /// Expiries the panel offers, in seconds.
  expirations Json

  minQty        Float  @default(1) @map("min_qty")
  qtyStep       Float  @default(1) @map("qty_step")
  currencyLeft  String @map("currency_left")
  currencyRight String @default("USD") @map("currency_right")

  /// Equal times mean around the clock.
  timeFrom       String @default("00:00:00") @map("time_from")
  timeTo         String @default("00:00:00") @map("time_to")
  /// Seven flags, Monday first.
  expirationDays Json   @map("expiration_days")
  exchange       String @default("na")
  image          String @default("") @db.VarChar(512)
  priority       Int    @default(100)

  isOtc       Boolean @default(false) @map("is_otc")
  isVisible   Boolean @default(true) @map("is_visible")
  isPaused    Boolean @default(false) @map("is_paused")
  isSuspended Boolean @default(false) @map("is_suspended")
  /// An asset that is off is not sent at all, as though it did not exist.
  enabled     Boolean @default(true)

  /// Only read when `source` is SIMULATED: the curve's centre, its
  /// peak-to-peak swing as a fraction of the centre, and the seconds one full
  /// swing of the slowest octave takes.
  simBase       Float? @map("sim_base")
  simVolatility Float? @map("sim_volatility")
  simPeriod     Int?   @map("sim_period")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([groupId])
  @@index([enabled])
  @@map("assets")
}

/// Anything else an administrator can change without a deploy.
///
/// One row per setting rather than one table of columns, because the engine's
/// own configuration is a moving set: the stubs it reads at boot each carry a
/// different shape, and they are served from here.
model PlatformSetting {
  key         String   @id
  value       Json
  /// What this controls, for whoever opens the admin and has never seen it.
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// What someone is allowed to do.
///
/// Deliberately not a boolean: the next distinction after "can change the
/// instrument catalogue" is never another boolean, and a column of flags is how
/// permission checks end up disagreeing with each other.
enum Role {
  USER
  ADMIN
}

/// How far an account has got through identity checks.
///
/// The live site gates funding on this, and shows the step someone is on in a
/// three-point progress rail: the address, then the details, then a document.
enum KycStatus {
  /// Nothing submitted.
  NONE
  /// Details given, document not yet accepted.
  PENDING
  APPROVED
  REJECTED
}

/// Someone who can sign in and trade.
///
/// The id is the `user_id` the protocol carries, not a surrogate: it travels in
/// `check-session`, in every portfolio event and in every deal, and the client
/// compares the one it was told at login against the one the feed reports. A
/// separate public id would mean translating at every boundary and getting it
/// wrong once. The counter starts high (see the migration) so an id is never
/// mistaken for a row number.
model User {
  id Int @id @default(autoincrement())

  email         String    @unique
  /// Set when the address has been confirmed. Null means unconfirmed, which is
  /// allowed to trade on practice and nothing else.
  emailVerified DateTime? @map("email_verified")
  passwordHash  String    @map("password_hash")

  name String?

  /**
   * Identity, as the verification form collects it. Separate first and last
   * names rather than one `name`, because the form asks for them separately —
   * it says to enter them exactly as the identity document spells them, and a
   * single field cannot be checked against a document that has two.
   */
  firstName   String?   @map("first_name")
  lastName    String?   @map("last_name")
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  /// ISO 3166-1 alpha-2, the country on the document.
  citizenship String?   @db.Char(2)
  /// Asked separately because it changes what a broker has to report.
  isUsPerson  Boolean   @default(false) @map("is_us_person")
  kycStatus   KycStatus @default(NONE) @map("kyc_status")
  /// Where the uploaded photo lives; null means the blank avatar.
  avatarUrl   String?   @map("avatar_url") @db.VarChar(512)

  /**
   * The name shown in rankings and public chats, and whether to show one.
   *
   * Not the real name: the platform generates a plausible one and lets people
   * reroll it, so that a leaderboard does not publish who someone is. With
   * `publicProfile` off they appear anonymously.
   */
  publicProfile Boolean @default(true) @map("public_profile")
  displayName   String? @map("display_name") @db.VarChar(64)

  /**
   * What they agreed to be sent, as the notification page writes it.
   *
   * JSON because it is a list of switches that grows whenever marketing wants
   * another one, and a column per switch would mean a migration each time.
   * Null means nobody has touched it and the defaults apply.
   */
  notifications Json?

  /// Set when the account is closed by its owner. It can be reopened, which is
  /// why this is a date and not a deletion.
  closedAt            DateTime? @map("closed_at")
  /// Set when its owner asks to be erased. Honouring it is a human decision.
  deletionRequestedAt DateTime? @map("deletion_requested_at")

  /**
   * Two-step sign-in with an authenticator app (TOTP, RFC 6238).
   *
   * The secret is stored encrypted with a key derived from AUTH_SECRET, so a
   * copy of the database alone does not hand anyone the second factor. It is
   * written when setup starts and only counts once `twoFactorEnabledAt` is
   * set, which happens when the person proves their app produces the codes.
   *
   * `twoFactorLastStep` is the 30-second step of the last code accepted; a code
   * is never accepted twice, so one read over a shoulder cannot be replayed
   * inside its own window. Recovery codes are kept as SHA-256 hashes and each
   * is removed when used. Failures are counted and lock the second step for a
   * while, because six digits is a million guesses and nothing else limits
   * them.
   */
  twoFactorSecret      String?   @map("two_factor_secret") @db.VarChar(255)
  twoFactorEnabledAt   DateTime? @map("two_factor_enabled_at")
  twoFactorLastStep    Int?      @map("two_factor_last_step")
  twoFactorRecovery    Json?     @map("two_factor_recovery")
  twoFactorFailures    Int       @default(0) @map("two_factor_failures")
  twoFactorLockedUntil DateTime? @map("two_factor_locked_until")

  /**
   * The wallet this person is trading on.
   *
   * Everyone has a real and a practice wallet, and the traderoom lets them
   * switch between the two. The engine keeps its own copy of the choice in its
   * client settings, but those live only as long as the process that answered
   * for them; this is what makes the choice survive a sign-out or a restart.
   *
   * Null means nobody has chosen yet, which resolves to the practice wallet —
   * a new account's real one is empty, and opening there reads as a broken
   * account rather than as an invitation to fund it.
   */
  activeBalanceId Int? @map("active_balance_id")

  /// E.164, the only form that is unambiguous across countries.
  phone         String    @unique
  /// ISO 3166-1 alpha-2, kept beside the number so a form can show it back in
  /// the national format the person typed.
  phoneCountry  String    @map("phone_country") @db.Char(2)
  phoneVerified DateTime? @map("phone_verified")

  locale String @default("en")

  /// Only ADMIN reaches /api/admin/*. There is no way to grant this through
  /// the application; `npm run admin:grant` is the only path, on purpose.
  role     Role    @default(USER)
  /// A disabled account keeps its history and cannot sign in.
  isActive Boolean @default(true) @map("is_active")

  balances        Balance[]
  positions       Position[]
  transactions    Transaction[]
  tournamentEntries TournamentEntry[]
  priceAlerts       PriceAlert[]
  alertTriggers     PriceAlertTrigger[]
  promoCodeUses     PromoCodeUse[]
  tradingSessions TradingSession[]

  /// Set when this person promotes the platform. See `Affiliate`.
  affiliate Affiliate?
  /// Set when this person arrived through someone else's link.
  referral  Referral?

  /// Identity documents sent for review, newest last.
  kycSubmissions KycSubmission[]
  paymentCards   PaymentCard[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// One wallet. The id is `user_balance_id` on the wire, for the same reason.
model Balance {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `IQBalanceType`: 1 is real money, 2 a tournament, 4 the practice balance.
  type Int @default(4)

  /// The tournament this wallet plays in, or 0 for the two ordinary ones.
  tournamentId Int @default(0) @map("tournament_id")

  /// Decimal, not a float. A stake and a payout are money, and a binary option
  /// settles on a comparison that a rounding error can invert.
  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("USD")
  isFiat   Boolean @default(true) @map("is_fiat")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /**
   * One wallet of each kind per person — and one per tournament entered.
   *
   * `tournamentId` is 0 rather than null for a real or practice wallet, which
   * is what keeps that promise. MySQL counts two NULLs as different values in
   * a unique index, so a nullable column here would quietly permit the second
   * real wallet this constraint exists to forbid.
   */
  @@unique([userId, type, tournamentId])
  @@map("balances")
}

/// The ssid the engine presents, and who it belongs to.
///
/// The engine reads an opaque session id out of `document.cookie` and sends it
/// in `authenticate`. The market server is a separate process with no access to
/// the web app's session, so this table is the handover: the traderoom page
/// mints a row for the signed-in person, and the feed resolves it here instead
/// of trusting whatever it is handed.
model TradingSession {
  /// The ssid itself. Random, and never derived from anything about the user.
  id String @id @db.Char(64)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Touched on each `authenticate`, so an abandoned session is visible.
  lastSeenAt DateTime? @map("last_seen_at")

  /**
   * Where it was opened from, for the Safety & Security page.
   *
   * Kept so that someone can recognise a session as theirs — or not. Stored as
   * the browser sent it and never parsed into anything load-bearing: a user
   * agent is a claim, not a fact.
   */
  userAgent String? @map("user_agent") @db.VarChar(255)
  ip        String? @db.VarChar(45)

  @@index([userId])
  @@index([expiresAt])
  @@map("trading_sessions")
}

/// A binary option, from the moment it is bought.
///
/// The market server holds running deals in memory because it settles them on a
/// one-second timer and answers `positions-state` from them, but memory is not
/// where they live: a restart with deals open used to lose them, and the
/// history panel had nothing to show. Every change is written here, and a
/// reconnecting session reads its open deals back.
///
/// The field set is the one `F2::DealBinary::parseAsPortfolioResponse` reads,
/// minus what can be derived — the instrument descriptor comes from the
/// catalogue, and `raw_event` is rebuilt from these columns. See
/// docs/avalon-backend.md.
model Position {
  /// The `external_id` the client reads, and the id it sends back.
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `user_balance_id`. Not a relation: a wallet can be deleted and a closed
  /// deal is still a record of what happened.
  balanceId Int @map("balance_id")

  activeId     Int    @map("active_id")
  /// 1 binary, 3 turbo, 12 blitz — `IQOptionType` by id.
  optionTypeId Int    @map("option_type_id")
  direction    String @db.VarChar(8)

  /// Money, as decimals. A binary option settles on a comparison, and a
  /// rounding error in a float inverts the result rather than nudging it.
  invest        Decimal  @db.Decimal(18, 2)
  profitPercent Int      @map("profit_percent")
  profitAmount  Decimal? @map("profit_amount") @db.Decimal(18, 2)
  closeProfit   Decimal? @map("close_profit") @db.Decimal(18, 2)
  currency      String   @default("USD")

  /// Quotes carry more decimals than money: five on a currency pair.
  openQuote  Decimal  @map("open_quote") @db.Decimal(18, 8)
  closeQuote Decimal? @map("close_quote") @db.Decimal(18, 8)

  /// Whole seconds, as the wire carries them.
  openTime       Int    @map("open_time")
  /// Milliseconds, which the portfolio's own events use instead.
  openTimeMs     BigInt @map("open_time_ms")
  expirationTime Int    @map("expiration_time")
  expirationSize Int    @map("expiration_size")
  /// Zero while the deal runs, which is how the wire says "still open".
  closedAt       Int    @default(0) @map("closed_at")

  /// `IQDealStatus`: open, win, loose, equal.
  status      String @default("open") @db.VarChar(16)
  /// `IQPositionCloseReason`: default while running, then win/loose/equal.
  closeReason String @default("default") @map("close_reason") @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The two reads this table serves: a session's open deals, and its history.
  @@index([userId, closedAt])
  @@index([userId, expirationTime])
  @@map("positions")
}

/// Money in or money out.
enum TransactionKind {
  DEPOSIT
  WITHDRAWAL
}

/// Where a request has got to. A withdrawal is a request until someone
/// approves it; a deposit is settled or it is not.
enum TransactionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A movement of money that is not a trade.
///
/// Deals have their own table because they settle themselves on a timer; these
/// settle because a person decided. Both feed the balance history, which is why
/// the amount is signed the same way in each: positive is money arriving.
model Transaction {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which wallet it moves. Not a relation: a wallet can go and the record of
  /// what happened should not go with it.
  balanceId Int @map("balance_id")

  kind   TransactionKind
  status TransactionStatus @default(PENDING)

  /// Always positive. `kind` says which way it goes — a negative deposit and a
  /// positive withdrawal are the same mistake written two ways.
  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("USD")

  /// The rail, as the cashier names it: "PIX (CPF)", "Bitcoin (BTC)".
  method      String  @db.VarChar(64)
  /// Where the money goes. Held for the operator and never shown back in full.
  destination String? @db.VarChar(255)
  /// Why it was rejected, or anything else a person needs to read later.
  note        String? @db.Text

  /**
   * What the platform keeps of a withdrawal, inside `amount`.
   *
   * Part of the amount rather than added to it: the balance moves by `amount`
   * and the person is paid `amount - fee`, so a refund gives back exactly what
   * left and nobody has to remember that a fee was once charged on top.
   */
  fee         Decimal @default(0) @db.Decimal(18, 2)
  /// A promo code's bonus, credited with the deposit when it is approved.
  bonus       Decimal @default(0) @db.Decimal(18, 2)
  /// The code that earned `bonus`. Not a relation: a code can be deleted and
  /// the record of what it paid should outlive it.
  promoCodeId Int?    @map("promo_code_id")
  /// The administrator who settled it, for whoever audits the queue later.
  settledById Int?    @map("settled_by_id")

  /// The saved card a card deposit was charged to. Not a relation, for the
  /// same reason as `balanceId`: the record outlives the card.
  cardId      Int?    @map("card_id")
  /// The payment processor's own id for the charge, to find it on their side.
  providerRef String? @map("provider_ref") @db.VarChar(191)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  /// When it stopped being pending.
  settledAt DateTime? @map("settled_at")

  @@index([userId, createdAt])
  @@index([status])
  @@map("transactions")
}

/// What a piece of editorial content is for.
///
/// One table rather than five, because the panels differ in where they are
/// shown far more than in what they hold: each is a dated item with a title, a
/// body, a picture and somewhere to go. Splitting them would mean four
/// near-identical tables and four near-identical admin screens.
enum ContentKind {
  /// The Webinars panel. Scheduled, and sorted into NEW and HISTORY by time.
  WEBINAR
  /// The Video Tutorials panel.
  TUTORIAL
  /// The Help panel.
  HELP
  /// The Promo panel's banners, as opposed to its promo codes.
  PROMO
}

/// Something an administrator writes for the traderoom to show.
model ContentItem {
  id Int @id @default(autoincrement())

  kind ContentKind

  /// ISO 639-1, or null for an item every language sees. The traderoom asks in
  /// one language at a time, and an item with no locale answers all of them —
  /// which is what a platform with three languages and one editor needs.
  locale String? @db.Char(2)

  title   String  @db.VarChar(255)
  /// The line under the title in a list.
  summary String? @db.VarChar(512)
  /// The whole text, for the panels that open an item rather than link away.
  body    String? @db.Text

  imageUrl String? @map("image_url") @db.VarChar(512)
  /// Where the item goes when opened: a video, an article, a sign-up page.
  linkUrl  String? @map("link_url") @db.VarChar(512)

  /// Who is presenting, for a webinar. Null for everything else.
  author String? @db.VarChar(128)

  /**
   * The group an item sits in, named rather than numbered.
   *
   * Help is not a flat list: the panel draws categories with questions inside
   * them, and the video library draws categories too. One free-text name keeps
   * that without a second table, and an editor who types the same name twice
   * gets one group rather than two — which is the behaviour to want here.
   *
   * The wire needs a numeric id for a category. It is derived from this name,
   * so it is the same on every read without being stored anywhere.
   */
  category String? @db.VarChar(96)

  /**
   * When it happens, and for how long.
   *
   * A webinar uses both: the panel splits its list on whether `startsAt` is
   * ahead or behind. News uses `startsAt` as its publication date. Help and
   * tutorials use neither, and an item with no `startsAt` is always current.
   */
  startsAt       DateTime? @map("starts_at")
  /// Minutes. What a webinar or a tutorial is worth setting aside for.
  durationMins   Int?      @map("duration_mins")
  /// After this, the item stops being offered. Null never expires.
  endsAt         DateTime? @map("ends_at")

  /// Higher first, then newest first. Lets an editor pin an item to the top.
  priority Int     @default(0)
  enabled  Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([kind, enabled, priority])
  @@map("content_items")
}

/// A dated release on the economic calendar, which is what this platform's
/// "Market Analysis" panel shows. Separate from `ContentItem` because an item
/// here is a measurement, not an article: it has a country, an importance and
/// three numbers that arrive at different times.
model CalendarEvent {
  id Int @id @default(autoincrement())

  /// ISO 3166-1 alpha-2, lower case — `us`, `br` — which is how the wire
  /// spells it and how the panel looks up its flag.
  country String @db.Char(2)
  name    String @db.VarChar(255)
  /// The source's own symbol for the series, e.g. `UNITEDSTANONMANPMI`.
  ticker  String? @db.VarChar(64)
  /// What the figure covers: `Sep`, `Q3`, `Oct/22`.
  period  String? @db.VarChar(32)

  /// 1 low, 2 medium, 3 high. The panel filters on it and colours by it.
  importance Int @default(2)
  /// Which filter group it belongs to: `prices`, `labour`, `gdp`, …
  categoryGroup String? @map("category_group") @db.VarChar(32)

  /// When it is published.
  releasedAt DateTime @map("released_at")

  /**
   * Strings, not numbers.
   *
   * A release carries its own units and precision — "55.4", "3.26%", "-1.2K"
   * — and the panel prints them as given. Parsing them into a number would
   * mean choosing a format to print them back in, which is a decision the
   * source already made.
   *
   * `actual` is empty until the figure is out, which is what makes a row
   * upcoming rather than past.
   */
  actual   String? @db.VarChar(32)
  forecast String? @db.VarChar(32)
  previous String? @db.VarChar(32)

  description String? @db.Text

  /// `active_id`s the release moves, shown as "assets affected".
  assetIds Json? @map("asset_ids")

  enabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([releasedAt])
  @@index([country, importance])
  @@map("calendar_events")
}

/// Where a tournament is in its life. The numbers are the platform's own, as
/// `get-tournaments-info` asks for them: the panel sends `status: [2, 3, 5]`
/// and keys its answer by the same values.
enum TournamentStatus {
  /// Open for entries, not started.
  REGISTERING
  /// Running.
  RUNNING
  /// Over.
  FINISHED
}

/// A competition with an entry fee, a prize pool and a live ranking.
model Tournament {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(160)
  description String? @db.Text
  imageUrl    String? @map("image_url") @db.VarChar(512)

  status TournamentStatus @default(REGISTERING)

  /// What it costs to enter, and to buy back in after busting.
  cost      Decimal @db.Decimal(18, 2)
  rebuy     Boolean @default(false)
  rebuyCost Decimal @default(0) @map("rebuy_cost") @db.Decimal(18, 2)

  /// What every entrant's tournament balance starts at.
  startingBalance Decimal @default(1000) @map("starting_balance") @db.Decimal(18, 2)

  prizePool Decimal @map("prize_pool") @db.Decimal(18, 2)
  /// `prizes` for a split pot, `cash` for a single payout — the panel's words.
  prizeType String  @default("prizes") @map("prize_type") @db.VarChar(24)
  currency  String  @default("USD")

  /// ISO 3166-1 alpha-2 codes the tournament is open to. Null means everywhere.
  countries Json?

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  enabled Boolean @default(true)

  entries TournamentEntry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, startsAt])
  @@map("tournaments")
}

/// One person's entry in one tournament.
model TournamentEntry {
  id Int @id @default(autoincrement())

  tournamentId Int        @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The wallet created for this tournament, which is where its deals are
  /// paid from. Not a relation: the wallet may be cleared when the tournament
  /// ends, and the record that someone took part should outlive it.
  balanceId Int? @map("balance_id")

  /// Running total, in tournament money. Settled deals keep it current.
  pnl Decimal @default(0) @db.Decimal(18, 2)

  registeredAt DateTime @default(now()) @map("registered_at")

  /// One entry per person per tournament; a rebuy tops the wallet back up
  /// rather than creating a second row.
  @@unique([tournamentId, userId])
  @@index([tournamentId, pnl])
  @@map("tournament_entries")
}

/// A price watch someone set on an instrument. The engine draws it as a line
/// on the chart and tells them when it is crossed.
model PriceAlert {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The protocol's `active_id`.
  assetId Int @map("asset_id")
  /// Which families the alert applies to, e.g. `["marginal-forex"]`.
  instrumentTypes Json @map("instrument_types")

  /// `price` or `market_open`, which are the two the panel asks for.
  type String @default("price") @db.VarChar(24)

  /// How many times it may fire before it stops. One is the panel's default.
  activations Int @default(1)

  /// The quote to watch for. Eight decimals, like a quote.
  value Decimal @db.Decimal(18, 8)

  /**
   * What the instrument cost when the alert was set.
   *
   * It is what gives the alert a direction. "Tell me at 1.0855" means
   * something different from above and from below, and without knowing which
   * side it started on, an alert set at a price the market is already past
   * fires the instant it is made.
   */
  createdQuote Decimal @map("created_quote") @db.Decimal(18, 8)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, assetId])
  @@map("price_alerts")
}

/// A code someone types to get a bonus. Written by an administrator; the
/// traderoom lists the ones on offer and the ones already used.
model PromoCode {
  id Int @id @default(autoincrement())

  code  String @unique @db.VarChar(48)
  title String @db.VarChar(160)

  /// The long text on the detail page, and the one line in the list.
  description      String? @db.Text
  descriptionShort String? @map("description_short") @db.VarChar(255)

  /// `deposit_bonus` is the one the recording shows; `higher_payouts` is the
  /// type the traderoom's own strip asks for by name.
  type String @default("deposit_bonus") @db.VarChar(32)

  /**
   * The three free-shaped blocks the panel renders.
   *
   * `params` carries whatever the type needs — a bonus percent, a minimum
   * deposit. `instructions` is `{title, steps: [{title, description}]}` and
   * `information` the detail copy. They are JSON because the platform treats
   * them as opaque: it renders what is there and nothing validates the shape
   * beyond the panel itself.
   */
  params       Json?
  instructions Json?
  information  Json?

  /// After this the code stops being offered. Null never expires.
  endsAt DateTime? @map("ends_at")

  enabled Boolean @default(true)

  uses PromoCodeUse[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("promo_codes")
}

/// One person's use of one code, which is what the "used" tab lists.
model PromoCodeUse {
  id Int @id @default(autoincrement())

  promoCodeId Int       @map("promo_code_id")
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  usedAt DateTime @default(now()) @map("used_at")

  /// A code is used once per person.
  @@unique([promoCodeId, userId])
  @@map("promo_code_uses")
}


/// An alert that went off. Kept apart from the alert so that deleting one does
/// not erase the record that it fired — the history tab is a log, and a log
/// that forgets is not one.
model PriceAlertTrigger {
  id Int @id @default(autoincrement())

  /// Null once the alert itself is gone.
  alertId Int? @map("alert_id")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assetId Int    @map("asset_id")
  type    String @default("price") @db.VarChar(24)

  /// What it was watching for, and what the market actually did.
  value Decimal @db.Decimal(18, 8)
  quote Decimal @db.Decimal(18, 8)

  firedAt DateTime @default(now()) @map("fired_at")

  @@index([userId, firedAt])
  @@map("price_alert_triggers")
}

/// Where someone is in the affiliate programme.
enum AffiliateStatus {
  /// Asked to join; an administrator has not looked yet. Links do not track.
  PENDING
  ACTIVE
  /// Stopped by an administrator. Links stop tracking and nothing new accrues,
  /// but what was already earned stays on the ledger.
  SUSPENDED
}

/// How an affiliate is paid.
enum CommissionPlan {
  /// A fixed amount once per referred person who qualifies.
  CPA
  /// A share of what the platform makes on a referred person's real trades.
  REVSHARE
  /// Both.
  HYBRID
}

/// One line on an affiliate's ledger.
enum CommissionKind {
  CPA
  REVSHARE
  /// Written by hand by an administrator, positive or negative.
  ADJUSTMENT
}

/**
 * Someone who brings people to the platform and is paid for it.
 * Not columns on `User`: most people are never affiliates, and the programme
 * carries its own settings, status and history. One per person.
 * The commercial terms are nullable on purpose. Null means "whatever the
 * programme pays", so changing the default in the admin changes it for every
 * affiliate who has not been given a deal of their own.
 */
model Affiliate {
  id Int @id @default(autoincrement())

  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What goes in the link: `?ref=CODE`. Upper case, letters and digits.
  code   String          @unique @db.VarChar(32)
  status AffiliateStatus @default(PENDING)

  plan            CommissionPlan?
  cpaAmount       Decimal?        @map("cpa_amount") @db.Decimal(18, 2)
  revsharePercent Decimal?        @map("revshare_percent") @db.Decimal(5, 2)

  /**
   * Called server to server when something happens to one of their referrals,
   * with the click's sub id in it, so their own tracker can attribute it. See
   * src/lib/affiliate/postback.ts for the macros and the checks on the address.
   */
  postbackUrl String? @map("postback_url") @db.VarChar(1024)

  /// For the administrators. Never shown to the affiliate.
  note String? @db.Text

  approvedAt DateTime? @map("approved_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  clicks      AffiliateClick[]
  referrals   Referral[]
  commissions AffiliateCommission[]
  payouts     AffiliatePayout[]
  postbacks   AffiliatePostback[]

  @@index([status])
  @@map("affiliates")
}

/// One visit through an affiliate's link.
model AffiliateClick {
  id Int @id @default(autoincrement())

  affiliateId Int       @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  /// The affiliate's own label for where the visit came from: `?sub=`.
  subId       String? @map("sub_id") @db.VarChar(64)
  utmSource   String? @map("utm_source") @db.VarChar(128)
  utmMedium   String? @map("utm_medium") @db.VarChar(128)
  utmCampaign String? @map("utm_campaign") @db.VarChar(128)

  /// The page the link pointed at, and the page the visitor came from.
  landing String? @db.VarChar(512)
  referer String? @db.VarChar(512)

  /// Kept to spot one person clicking their own link a thousand times, and to
  /// count unique visitors. Never shown to the affiliate.
  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(255)
  /// ISO 3166-1 alpha-2, from the proxy in front of the app when it says.
  country   String? @db.Char(2)

  createdAt DateTime @default(now()) @map("created_at")

  referrals Referral[]

  @@index([affiliateId, createdAt])
  @@map("affiliate_clicks")
}

/**
 * Who brought whom.
 * Written once, when the account is created, from the click the visitor's
 * browser was carrying. The first deposit is recorded here too, because it is
 * the moment most affiliate deals are about and asking for it every time from
 * the transactions table means asking "the earliest approved deposit of each of
 * these people", which is the expensive query.
 */
model Referral {
  id Int @id @default(autoincrement())

  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  affiliateId Int       @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  clickId Int?            @map("click_id")
  click   AffiliateClick? @relation(fields: [clickId], references: [id], onDelete: SetNull)

  /// Copied from the click, so the sub-id report does not depend on it.
  subId String? @map("sub_id") @db.VarChar(64)
  /// The address the account was created from.
  ip    String? @db.VarChar(45)

  /// First approved deposit.
  ftdAt     DateTime? @map("ftd_at")
  ftdAmount Decimal?  @map("ftd_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([affiliateId, createdAt])
  @@map("referrals")
}

/**
 * Money an affiliate has earned, or lost.
 * A ledger rather than a balance column: the balance is the sum of these minus
 * what has been paid out, so it cannot drift from the record of how it came to
 * be. Revenue share is signed — a referred person who wins takes the
 * affiliate's share down with the platform's.
 * `(kind, sourceId)` is what makes accrual safe to run twice. A revenue-share
 * line is keyed by the deal it came from and a CPA line by the person it was
 * paid for, so writing the same one again is refused by the database instead
 * of paid twice. An adjustment has no source, and MySQL lets any number of
 * NULLs through a unique index, which is exactly right for those.
 */
model AffiliateCommission {
  id Int @id @default(autoincrement())

  affiliateId Int       @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  /// Not a relation: an account can be erased and the line must stay.
  referredUserId Int? @map("referred_user_id")

  kind     CommissionKind
  amount   Decimal        @db.Decimal(18, 2)
  /// What it was computed from: the platform's result on the deal, or the
  /// deposits that qualified the CPA. Null for an adjustment.
  base     Decimal?       @db.Decimal(18, 2)
  /// The percent applied, for revenue share.
  rate     Decimal?       @db.Decimal(5, 2)
  currency String         @default("USD")

  /// The deal for REVSHARE, the referred user for CPA, null for ADJUSTMENT.
  sourceId Int?    @map("source_id")
  note     String? @db.VarChar(255)

  /// When the money was made — the deal's close, the deposit's approval —
  /// not when this row was written, which can be later.
  earnedAt    DateTime  @map("earned_at")
  /// Until then it is held, so a chargeback or a reversed deposit can be
  /// caught before it has been paid out.
  availableAt DateTime  @map("available_at")
  /// Set by an administrator who takes it back. A reversed line counts for
  /// nothing but stays visible, so the history explains the balance.
  reversedAt  DateTime? @map("reversed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([kind, sourceId])
  @@index([affiliateId, earnedAt])
  @@map("affiliate_commissions")
}

/// An affiliate asking to be paid what they have earned.
model AffiliatePayout {
  id Int @id @default(autoincrement())

  affiliateId Int       @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  amount      Decimal           @db.Decimal(18, 2)
  currency    String            @default("USD")
  method      String            @db.VarChar(64)
  destination String            @db.VarChar(255)
  status      TransactionStatus @default(PENDING)
  note        String?           @db.Text

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  settledAt   DateTime? @map("settled_at")
  settledById Int?      @map("settled_by_id")

  @@index([affiliateId, createdAt])
  @@index([status])
  @@map("affiliate_payouts")
}

/// One server-to-server call to an affiliate's tracker, and how it went.
model AffiliatePostback {
  id Int @id @default(autoincrement())

  affiliateId Int       @map("affiliate_id")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  /// `registration`, `ftd`, `cpa`.
  event  String  @db.VarChar(24)
  url    String  @db.VarChar(1024)
  /// The HTTP status that came back, or null when nothing did.
  status Int?
  error  String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([affiliateId, createdAt])
  @@map("affiliate_postbacks")
}

/// What an identity document is. A Brazilian RG or CIN is an ID card; a CNH
/// is a driver's licence.
enum KycDocumentType {
  ID_CARD
  DRIVERS_LICENSE
  PASSPORT
  RESIDENCE_PERMIT
}

/**
 * One set of identity documents sent for review: the front, the back where the
 * document has one, and a selfie holding it.
 *
 * A row per attempt rather than columns on the user, because a rejected
 * attempt is part of the record — the next reviewer should see what was sent
 * before and why it was turned down. The account's own `kycStatus` follows the
 * latest decision.
 *
 * The files are named, not linked: they live outside `public` and are only
 * ever served through a route that checks the person asking is the owner or an
 * administrator. A URL in a column is a URL someone pastes into a chat.
 */
model KycSubmission {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ISO 3166-1 alpha-2 of the country that issued the document.
  country        String          @db.Char(2)
  documentType   KycDocumentType @map("document_type")
  /// The document's number — or, for Brazil, the CPF, which every document
  /// there carries and which is what a Brazilian KYC is keyed on.
  documentNumber String          @map("document_number") @db.VarChar(64)

  frontFile  String  @map("front_file") @db.VarChar(96)
  backFile   String? @map("back_file") @db.VarChar(96)
  selfieFile String  @map("selfie_file") @db.VarChar(96)

  /// PENDING until reviewed; then APPROVED or REJECTED.
  status       KycStatus @default(PENDING)
  /// Why it was rejected, shown to the person so they can fix it.
  reason       String?   @db.Text
  reviewedById Int?      @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  /// The same document sent from two accounts is the first thing a reviewer wants to know.
  @@index([country, documentNumber])
  @@map("kyc_submissions")
}

/**
 * A card someone saved, as the payment processor describes it back.
 *
 * Never the number and never the security code: the card is typed into the
 * processor's own fields, which hand back a token, and the token is what is
 * stored and charged. What is kept besides is only what a person needs to
 * recognise their card — brand, last four digits, expiry, the name on it —
 * and the processor's fingerprint, which says two tokens are the same card
 * without saying which card.
 *
 * Removing a card stamps `removedAt` rather than deleting the row, so the
 * deposits charged to it can still say which card that was.
 */
model PaymentCard {
  id Int @id @default(autoincrement())

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Which processor holds it: "sandbox" today, a real one later.
  provider    String @db.VarChar(32)
  token       String @db.VarChar(191)
  fingerprint String @db.VarChar(64)

  brand    String @db.VarChar(16)
  last4    String @db.Char(4)
  expMonth Int    @map("exp_month") @db.SmallInt
  expYear  Int    @map("exp_year") @db.SmallInt
  holder   String @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at")
  removedAt DateTime? @map("removed_at")

  @@unique([provider, token])
  @@index([userId, removedAt])
  @@map("payment_cards")
}
