# Mirrored third-party engine build, refetched by scripts/download-engine.mjs
public/engine/

# Frame transcript from npm run server:trace
server/.transcript.jsonl

# Browser network captures may contain session credentials
*.har

/src/generated/prisma

# Per-editor mirrors of the Prisma skills. The canonical copy is the one under
# .agents/skills/, which AGENTS.md names; `prisma skills sync` regenerates the
# rest for whichever tool is in use.
/.windsurf

# Page captures pulled from the live site while cloning. They carry the
# account's own data — email, profile id, balances — and exist to be read
# during the work, not to be kept.
/docs/research/captures

# Uploaded files. They belong to whoever uploaded them, not to the repository.
/var

# Mirrored third-party artwork, refetched by scripts/download-artwork.mjs
public/storage/
